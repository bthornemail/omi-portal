# Declarative OMI files are not runtime authority by themselves.
# Runtime authority requires pointer, rule, implementation, test,
# and replay/projection path.

# [Closure 0x01]: Frame Validation Before Projection
omi-0000-0000-0000-0000-0000-0000-0079-c001/128 CLOSE frame-validation-before-projection

REQUIRES:
  Q_frame(S) = 0

SEALS:
  128-bit envelope

FORBIDS:
  symbolic-projection-authorizes-invalid-frame

BOUNDARY:
  Q_frame validates first
  Q_xy projects second

# [Closure 0x02]: Replay Ring Closure
omi-0000-0000-0000-0000-0000-0000-5040-c002/128 CLOSE fano-spo-local240-replay-ring

REQUIRES:
  fano7 in 0..6
  role3 in 0..2
  local240 in 0..239

FORM:
  slot5040 = fano7×720 + role3×240 + local240

SEALS:
  slot5040 in 0..5039

# [Closure 0x03]: Symbolic Projection Authority Closure
omi-0000-0000-0000-0000-0000-0000-007b-c003/128 CLOSE symbolic-projection-authority-boundary

REQUIRES:
  pointer
  rule
  implementation
  test
  replay/projection path

FORBIDS:
  Base36-authorizes-invalid-frame
  emoji-authorizes-invalid-frame
  domino-authorizes-invalid-frame
  canvas-color-authorizes-invalid-frame

AUTHORITY:
  projection-only

# [Closure 0x04]: Local240 Boundedness Closure
omi-0000-0000-0000-0000-0000-0000-00f0-c004/128 CLOSE local240-boundedness

FORM:
  local240 = Q_xy(x,y) mod 240

SEALS:
  local240 in 0..239

BOUNDARY:
  local240 follows Q_frame validation

# [Closure 0x05]: Q Frame / Q XY Non-Collapse Boundary
omi-0000-0000-0000-0000-0000-0000-0079-c005/128 CLOSE q-frame-q-xy-non-collapse-boundary

TRUTH:
  Q_frame(S) validates the 128-bit OMI envelope
  Q_xy(x,y)=60x²+16xy+4y² projects decoded state into geometry

FORBIDS:
  deriving-validity-from-projection
  dot-notation-replaces-Q-frame-validation

BOUNDARY:
  validate first
  project second
  replay third
  show fourth
